#include "main.h"

volatile uint8_t blink_enable = 1;

int main(void)
{
    RCC->AHB2ENR |= (1 << 0);
    RCC->AHB2ENR |= (1 << 2);
    RCC->APB2ENR |= (1 << 0);

    GPIOA->MODER &= ~(3 << (5 * 2));
    GPIOA->MODER |=  (1 << (5 * 2));

    GPIOC->MODER &= ~(3 << (13 * 2));
    GPIOC->PUPDR &= ~(3 << (13 * 2));
    GPIOC->PUPDR |=  (1 << (13 * 2));
    SYSCFG->EXTICR[3] &= ~(0xF << 4);
    SYSCFG->EXTICR[3] |=  (0x2 << 4);

    EXTI->IMR1  |= (1 << 13);
    EXTI->FTSR1 |= (1 << 13);
    EXTI->RTSR1 &= ~(1 << 13);

    NVIC_EnableIRQ(EXTI15_10_IRQn);

    SysTick->LOAD = 16000000 / 2 - 1;
    SysTick->VAL  = 0;
    SysTick->CTRL = (1 << 2) | (1 << 1) | (1 << 0); // CLKSRC | TICKINT | ENABLE

    while (1)
    {
        __WFI();
    }
}

void SysTick_Handler(void)
{
    if (blink_enable)
    {
        GPIOA->ODR ^= (1 << 5);
    }
}


void EXTI15_10_IRQHandler(void)
{
    if (EXTI->PR1 & (1 << 13))
    {
        blink_enable ^= 1;
        EXTI->PR1 |= (1 << 13);
    }
}

