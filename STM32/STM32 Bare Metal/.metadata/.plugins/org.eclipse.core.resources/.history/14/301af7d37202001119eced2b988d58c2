#include "main.h"

#define RX_BUF_SIZE 16

/* ===== Debug-visible variables ===== */
volatile char tx_char = 'A';
volatile char rx_buffer[RX_BUF_SIZE];
volatile uint8_t rx_index = 0;

/* ===== Simple delay ===== */
void delay(volatile uint32_t d)
{
    while (d--);
}

/* ===== USART2 Init (Interrupt mode) ===== */
void USART2_Init(void)
{
    /* 1. Enable clocks */
    RCC->AHB2ENR  |= (1 << 0);     // GPIOA
    RCC->APB1ENR1 |= (1 << 17);    // USART2

    /* 2. PA2 (TX), PA3 (RX) -> Alternate Function */
    GPIOA->MODER &= ~((3 << (2 * 2)) | (3 << (3 * 2)));
    GPIOA->MODER |=  ((2 << (2 * 2)) | (2 << (3 * 2)));

    /* 3. AF7 for USART2 */
    GPIOA->AFR[0] &= ~((0xF << (2 * 4)) | (0xF << (3 * 4)));
    GPIOA->AFR[0] |=  ((7   << (2 * 4)) | (7   << (3 * 4)));

    /* 4. Reset USART */
    USART2->CR1 = 0;
    USART2->CR2 = 0;
    USART2->CR3 = 0;

    /* 5. Baud rate (PCLK1 = 16 MHz assumed) */
    USART2->BRR = 16000000 / 9600;

    /* 6. Enable RXNE interrupt */
    USART2->CR1 |= (1 << 5);   // RXNEIE

    /* 7. Enable TX and RX */
    USART2->CR1 |= (1 << 3) | (1 << 2); // TE, RE

    /* 8. Enable USART */
    USART2->CR1 |= (1 << 0);   // UE

    /* 9. Enable NVIC */
    NVIC_EnableIRQ(USART2_IRQn);
}

/* ===== Send one character ===== */
void USART2_SendChar(char c)
{
    while (!(USART2->ISR & (1 << 7)));  // TXE
    USART2->TDR = c;
}

/* ===== USART2 RX Interrupt Handler ===== */
void USART2_IRQHandler(void)
{
    if (USART2->ISR & (1 << 5))   // RXNE
    {
        rx_buffer[rx_index++] = USART2->RDR; // Reading clears RXNE

        if (rx_index >= RX_BUF_SIZE - 1)
            rx_index = 0;

        rx_buffer[rx_index] = '\0'; // For string view
    }
}

int main(void)
{
    USART2_Init();

    while (1)
    {
        USART2_SendChar(tx_char); // Triggers RX interrupt via loopback
        tx_char = (tx_char+1)%128;
        delay(300000);
    }
}
