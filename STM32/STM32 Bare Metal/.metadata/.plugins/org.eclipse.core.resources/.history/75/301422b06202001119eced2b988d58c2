#include "main.h"

void USART2_Init(void)
{
    /* Enable clocks */
    RCC->AHB2ENR  |= (1 << 0);    // GPIOA
    RCC->APB1ENR1 |= (1 << 17);   // USART2

    /* PA2 (TX), PA3 (RX) -> Alternate Function */
    GPIOA->MODER &= ~((3 << (2 * 2)) | (3 << (3 * 2)));

    GPIOA->MODER |=  ((2 << (2 * 2)) | (2 << (3 * 2)));

    /* AF7 for USART2 */
    GPIOA->AFR[0] &= ~((0xF << (2 * 4)) | (0xF << (3 * 4)));
    GPIOA->AFR[0] |=  ((7 << (2 * 4)) | (7 << (3 * 4)));

    /* Baud rate */
    USART2->BRR = 16000000 / 9600;

    /* Enable TX, RX */
    USART2->CR1 |= (1 << 3) | (1 << 2);  // TE, RE
    USART2->CR1 |= (1 << 0);             // UE
}

void USART2_SendChar(char c)
{
    while (!(USART2->ISR & (1 << 7))); // TXE
    USART2->TDR = c;
}

void USART2_SendString(char *str)
{
    while (*str)
    {
        USART2_SendChar(*str++);
    }
}

char USART2_ReadChar(void)
{
    while (!(USART2->ISR & (1 << 5))); // RXNE
    return USART2->RDR;
}


int main(void)
{
    char ch;

    USART2_Init();
    USART2_SendString("STM32 UART Ready\r\n");

    while (1)
    {
        ch = USART2_ReadChar();   // Wait for data
        USART2_SendChar(ch);      // Echo to PuTTY
    }
}

