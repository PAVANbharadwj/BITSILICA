#include<main.h>

#define RX_BUF_SIZE 64

volatile char rx_buffer[RX_BUF_SIZE];
volatile uint8_t rx_index = 0;

void USART2_Init(void)
{
    RCC->AHB2ENR  |= (1 << 0);     // GPIOA
    RCC->APB1ENR1 |= (1 << 17);    // USART2

    /* PA2 -> TX, PA3 -> RX */
    GPIOA->MODER &= ~((3 << (2 * 2)) | (3 << (3 * 2)));
    GPIOA->MODER |=  ((2 << (2 * 2)) | (2 << (3 * 2)));

    GPIOA->AFR[0] &= ~((0xF << (2 * 4)) | (0xF << (3 * 4)));
    GPIOA->AFR[0] |=  ((7 << (2 * 4)) | (7 << (3 * 4))); // AF7

    /* Baud rate (16 MHz clock assumed) */
    USART2->BRR = 0x0683;

    /* Enable TX and RX */
    USART2->CR1 |= (1 << 3) | (1 << 2);  // TE, RE
    USART2->CR1 |= (1 << 0);             // UE
}


char USART2_ReadChar(void)
{
    while (!(USART2->ISR & (1 << 5))); // RXNE
    return USART2->RDR;                // clears RXNE
}


int main(void)
{
    char ch;

    USART2_Init();

    while (1)
    {
        ch = USART2_ReadChar();   // Blocking wait

        rx_buffer[rx_index++] = ch;

        if (rx_index >= RX_BUF_SIZE)
        {
            rx_index = 0;         // Wrap (circular buffer)
        }
    }
}

